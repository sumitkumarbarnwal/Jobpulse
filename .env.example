# ─────────────────────────────────────────────────
# JobPulse — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ─────────────────────────────────────────────────

# ── Source Selection ───────────────────────────
# Options: arbeitnow | mock
JOB_SOURCE=arbeitnow

# ── Mock Scenario (only used when JOB_SOURCE=mock) ──
# Options: normal | empty | rate_limited | server_error | slow | malformed
MOCK_SCENARIO=normal

# ── Database ───────────────────────────────────
# Relative path from backend/ or absolute path
DATABASE_URL=sqlite:///./jobpulse.db

# ── CORS ───────────────────────────────────────
# Comma-separated list of allowed origins
# For production, set to your frontend domain
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Ingestion ──────────────────────────────────
# How often the background scheduler runs (seconds). 0 = manual only.
INGESTION_INTERVAL_SECONDS=0

# ── Circuit Breaker ────────────────────────────
# Number of consecutive failures before opening the circuit
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Seconds to wait before attempting half-open probe
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60

# ── Rate Limiter / HTTP ────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_INITIAL_BACKOFF_SECONDS=1.0
HTTP_MAX_BACKOFF_SECONDS=60.0

# ── Application ────────────────────────────────
APP_ENV=development
# Set to false to show detailed errors in API responses (development only)
HIDE_ERROR_DETAILS=false
